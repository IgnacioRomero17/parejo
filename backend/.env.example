# Copiar como .env y completar. El .env no se versiona.
DJANGO_SECRET_KEY=
# Con False se activa la configuración de producción: HTTPS obligatorio, cookies seguras y WhiteNoise.
DJANGO_DEBUG=True
DB_NAME=parejo
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Opcionales. Base de los enlaces de los correos (la URL del frontend).
# URL_FRONTEND=http://localhost:5173
# Correo: por defecto se muestra en la consola. En producción, SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=parejo <no-responder@example.com>

# Solo para la versión publicada (ver DEPLOY.md):
# DJANGO_ALLOWED_HOSTS=parejo.onrender.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://parejo.onrender.com
# DB_SSLMODE=require
